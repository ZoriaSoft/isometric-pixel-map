; Isometric Pixel Map Generator — Godot 4.6.2 Web-first
; Landscape + gl_compatibility (Web export zorunlu)

config_version=5

[application]

config/name="Isometric Pixel Map"
config/description="Retro isometric pixel map editor — paint, export PNG/JSON"
config/version="0.7.0+14"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/low_processor_mode=true
config/icon="res://assets/images/icon.svg"

[autoload]

Game="*res://scripts/autoload/Game.gd"
L="*res://scripts/autoload/L.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0706, 0.0627, 0.0509, 1)
